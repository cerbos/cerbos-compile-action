{
  "name": "cerbos-compile-action",
  "private": true,
  "description": "A GitHub action to compile Cerbos policies and execute policy tests",
  "keywords": [
    "actions",
    "compile",
    "node"
  ],
  "license": "Apache-2.0",
  "author": "Cerbos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerbos/cerbos-compile-action.git"
  },
  "type": "module",
  "scripts": {
    "all:parallel": "pnpm --no-bail --aggregate-output --reporter=append-only --reporter-hide-prefix run",
    "build": "rm -rf dist && rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "lint": "pnpm run all:parallel /^lint:check:/",
    "lint:check:oxfmt": "pnpm run oxfmt --check",
    "lint:check:oxlint": "pnpm run oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm run lint:fix:oxlint && pnpm run lint:fix:oxfmt",
    "lint:fix:oxfmt": "pnpm run oxfmt",
    "lint:fix:oxlint": "pnpm run oxlint --fix",
    "oxfmt": "oxfmt",
    "oxlint": "oxlint --type-aware",
    "test": "glob-bin -c \"node --import tsx --no-warnings --test\" \"./tests/**/*.test.ts\""
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "cerbos-actions-common": "github:cerbos/cerbos-actions-common#0.0.38"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/node": "26.6.6",
    "glob-bin": "1.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rollup": "4.66.0",
    "tslib": "^2.8.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
